{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qalab.bug_report/1",
  "title": "Final bug report: one item of bugs.json",
  "description": "Built by qalab triage from a cluster plus an LLM draft (or the template fallback). Evidence IDs from the prompt are resolved to run_id + seq here.",
  "type": "object",
  "required": [
    "schema", "id", "signature", "kind", "title", "component", "severity", "priority", "score",
    "summary", "steps_to_reproduce", "expected", "actual", "suspected_cause", "frequency",
    "environment", "evidence", "confidence", "needs_review", "generator"
  ],
  "properties": {
    "schema": { "const": "qalab.bug_report/1" },
    "id": { "type": "string", "pattern": "^QAL-[0-9]{4}$" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "kind": { "enum": ["log", "detector", "visual"] },
    "title": { "type": "string", "maxLength": 100 },
    "component": { "type": "string" },
    "severity": { "enum": ["S1", "S2", "S3", "S4"], "description": "From the LLM draft (or template rules)." },
    "priority": { "enum": ["P1", "P2", "P3", "P4"], "description": "Computed by the ranking formula, never by the LLM." },
    "score": { "type": "number", "minimum": 0 },
    "score_breakdown": { "type": "object", "additionalProperties": { "type": "number" } },
    "summary": { "type": "string" },
    "steps_to_reproduce": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "source"],
        "properties": {
          "text": { "type": "string" },
          "source": { "enum": ["bot_log", "inferred", "template"] },
          "action_refs": { "type": "array", "items": { "$ref": "#/$defs/eventRef" } }
        },
        "additionalProperties": false
      }
    },
    "expected": { "type": "string" },
    "actual": { "type": "string" },
    "suspected_cause": { "type": "string" },
    "frequency": {
      "type": "object",
      "required": ["count", "runs"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "runs": { "type": "integer", "minimum": 1 },
        "first_seen_t": { "type": "number", "minimum": 0 },
        "last_seen_t": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "builds": { "type": "array", "items": { "type": "string" } },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "scenes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/eventRef" } },
    "attachments": { "type": "array", "items": { "type": "string" }, "description": "Screenshot paths, relative to the reports folder." },
    "docs_used": { "type": "array", "items": { "type": "string" }, "description": "Doc chunk ids, e.g. sandbox_design.md#doors-0" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_review": { "type": "boolean" },
    "review_reasons": { "type": "array", "items": { "type": "string" } },
    "generator": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "enum": ["llm", "template"] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": "string" },
        "latency_ms": { "type": "number", "minimum": 0 },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 },
        "cached": { "type": "boolean" },
        "attempts": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "eventRef": {
      "type": "object",
      "required": ["run_id", "seq"],
      "properties": {
        "run_id": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
