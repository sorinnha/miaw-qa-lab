{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qalab.run/1",
  "title": "QA Lab run metadata: run.json",
  "description": "Written at run start and rewritten at run end. A missing ended_at means the run did not finish cleanly (possible crash).",
  "type": "object",
  "required": ["schema", "run_id", "project", "mode", "seed", "started_at"],
  "properties": {
    "schema": { "const": "qalab.run/1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "description": "Windows-safe, e.g. 20261005T103000Z-s42" },
    "project": { "type": "string" },
    "qalab_version": { "type": "string" },
    "build": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "platform": { "type": "string" },
        "unity": { "type": "string" },
        "git_sha": { "type": ["string", "null"] },
        "development": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "mode": { "enum": ["player", "editor_playmode", "manual"] },
    "adapter": { "type": "string", "description": "Bot adapter name, or manual." },
    "seed": { "type": "integer" },
    "scenes": { "type": "array", "items": { "type": "string" } },
    "duration_s": { "type": "number", "minimum": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "exit_reason": { "enum": ["duration_elapsed", "fatal_detector", "user_quit", "test_finished", "unknown", null] },
    "exit_code": { "type": ["integer", "null"] },
    "machine": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "cpu": { "type": "string" },
        "gpu": { "type": "string" },
        "ram_gb": { "type": "number" }
      },
      "additionalProperties": false
    },
    "benchmark": { "type": "boolean", "description": "true when labels.json is written for evaluation." },
    "seeds_enabled": { "type": "array", "items": { "type": "string", "pattern": "^SB[0-9]{2}$" } }
  },
  "additionalProperties": false
}
