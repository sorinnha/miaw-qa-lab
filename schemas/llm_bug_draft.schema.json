{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qalab.llm_bug_draft/1",
  "title": "LLM bug draft: the structured output requested from the model",
  "description": "Flat on purpose (no $ref, every property required, additionalProperties false) so every provider's structured-output mode accepts it. E*, A* and D* are IDs of items listed in the prompt.",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "component": { "type": "string" },
    "severity": { "type": "string", "enum": ["S1", "S2", "S3", "S4"] },
    "summary": { "type": "string" },
    "steps_to_reproduce": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "source": { "type": "string", "enum": ["bot_log", "inferred"] },
          "action_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["text", "source", "action_ids"],
        "additionalProperties": false
      }
    },
    "expected": { "type": "string" },
    "actual": { "type": "string" },
    "suspected_cause": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "doc_ids": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number" }
  },
  "required": [
    "title", "component", "severity", "summary", "steps_to_reproduce", "expected",
    "actual", "suspected_cause", "evidence_ids", "doc_ids", "confidence"
  ],
  "additionalProperties": false
}
