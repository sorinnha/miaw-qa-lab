# Normalize line endings; keep data files LF so Unity and Python agree.
* text=auto

*.cs      text diff=csharp
*.py      text diff=python
*.md      text
*.json    text eol=lf
*.jsonl   text eol=lf
*.toml    text
*.yml     text
*.ps1     text eol=crlf

# Unity YAML: LF, and hide it from GitHub language stats and diffs.
*.unity      text eol=lf linguist-generated
*.prefab     text eol=lf linguist-generated
*.asset      text eol=lf linguist-generated
*.meta       text eol=lf linguist-generated
*.mat        text eol=lf linguist-generated
*.anim       text eol=lf linguist-generated
*.controller text eol=lf linguist-generated

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.fbx  binary
*.ttf  binary
*.otf  binary
