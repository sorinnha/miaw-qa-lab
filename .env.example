# Copy to .env (gitignored) and fill in. Never commit .env or paste keys into chat.

# Which model the qalab tool calls at runtime: ollama | gemini | openai | anthropic | fake | none
QALAB_PROVIDER=ollama
# Model names (Claude Code recommends these in M0 based on your PC; see docs/ENVIRONMENT.md)
QALAB_MODEL=
QALAB_EMBED_MODEL=
QALAB_VISION_MODEL=

# Local models
OLLAMA_HOST=http://localhost:11434

# Hosted models (optional, only for the provider you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Unity editor used by scripts\*.ps1 (optional; found automatically from Unity Hub if empty)
UNITY_EXE=
