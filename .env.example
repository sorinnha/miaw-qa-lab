# Copy to .env (gitignored) and fill in. Never commit .env or paste keys into chat.

# Which model the qalab tool calls at runtime: ollama | gemini | openai | anthropic | fake | none
# (qalab.toml already sets gemini; leave empty to use it)
QALAB_PROVIDER=
# Model names override qalab.toml [llm] model / embed_model (e.g. gemini-2.5-flash, gemini-embedding-001)
QALAB_MODEL=
QALAB_EMBED_MODEL=
QALAB_VISION_MODEL=

# Local models
OLLAMA_HOST=http://localhost:11434

# Hosted models (optional, only for the provider you use). Free tiers may use what you send to
# improve the provider's products: send sandbox data only (README, Data handling).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Unity editor used by scripts\*.ps1 (optional; found automatically from Unity Hub if empty)
UNITY_EXE=
